<% # Use the bookmarkable item's id unless we're dealing with a bookmark of a deleted item %> 
<% bookmark_form_id ="#{@destination}" %>

var bookmark_div = $j("#bookmark_form_placement_for_<%= bookmark_form_id %>");

if (!bookmark_div.children().length) {
  if ($j("#bookmark_<%= @bookmark.id %>").length !== 0) {
    bookmark_div.html("<%= escape_javascript(render "bookmarks/bookmark_form", bookmarkable: @bookmarkable, bookmark: @bookmark, button_name: @button_name, action: @action, in_page: true, dynamic: true, on_screen: true) %>");
  } else {
    bookmark_div.html("<%= escape_javascript(render "bookmarks/bookmark_form", bookmarkable: @bookmarkable, bookmark: @bookmark, button_name: @button_name, action: @action, in_page: true, dynamic: true, on_screen: false) %>");
  }
}
$j(".bookmark_form_trigger_for_<%= bookmark_form_id %>").hide();

<%= render "form_jquery", id: bookmark_form_id %>
